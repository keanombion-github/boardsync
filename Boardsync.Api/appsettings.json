{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FrontendOrigin": "http://localhost:3000",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"]
  },
  "Jwt": {
    "Issuer": "Boardsync.Api",
    "Audience": "Boardsync.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
