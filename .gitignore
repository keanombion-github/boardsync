## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ins.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# Mac OS X
.DS_Store

# Node
node_modules/
dist/
.next/
.env.local
.env.development.local
.env.test.local
.env.production.local

# Rider
.idea/
*.sln.iml

# Secrets / AppSettings
appsettings.Development.json
appsettings.Production.json
appsettings.Local.json
